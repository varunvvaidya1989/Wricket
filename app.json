{
  "expo": {
    "name": "SportStage",
    "slug": "sportstage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sportstage-app-icon-v2.png",
    "scheme": "sportstage",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vcreativestudio.sportstage",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.vcreativestudio.sportstage",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E1014",
        "foregroundImage": "./assets/images/sportstage-app-icon-v2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sportstage-app-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sportstage-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1014",
          "dark": {
            "backgroundColor": "#0E1014"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SportStage to select tournament logos and banners."
        }
      ],
      "expo-font"
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9804fe3d-1430-4c87-a2a2-d6794deb4e62"
      }
    },
    "owner": "vcreativestudio"
  }
}

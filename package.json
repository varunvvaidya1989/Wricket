{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "start": "expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "supabase:cli": "supabase",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:preflight": "node scripts/e2e/preflight.mjs",
    "test:e2e:web:smoke": "playwright test --project=chromium --project=mobile-chromium --grep @smoke",
    "test:e2e:web": "playwright test",
    "check:env": "node scripts/check-env.js",
    "check:architecture": "node scripts/check-architecture.js",
    "launch:check": "node scripts/check-launch-readiness.mjs",
    "migrate:auction-yodha-players": "node scripts/migrate-auction-yodha-players.mjs",
    "recalculate-mvp": "node scripts/recalculate-mvp.mjs",
    "demo:non-cricket:seed": "node scripts/manage-non-cricket-demo.mjs seed --production",
    "demo:non-cricket:status": "node scripts/manage-non-cricket-demo.mjs status --production",
    "demo:non-cricket:clear": "node scripts/manage-non-cricket-demo.mjs clear --production",
    "build:check": "npm run lint && npm run typecheck && npm run test && npm run check:env && npm run check:architecture && npx expo export --platform web --output-dir dist",
    "mvp:worker:local": "node scripts/cricket-mvp-worker.mjs --local",
    "mvp:edge:build": "node scripts/build-cricket-mvp-edge.mjs",
    "mvp:edge:check": "node scripts/build-cricket-mvp-edge.mjs --check",
    "mvp:edge:deploy": "node scripts/deploy-cricket-mvp-edge.mjs --production",
    "mvp:worker:production": "node scripts/cricket-mvp-worker.mjs --production",
    "mvp:monitor:local": "node scripts/cricket-mvp-monitor.mjs --local",
    "mvp:monitor:production": "node scripts/cricket-mvp-monitor.mjs --production",
    "supabase:hosted:preflight": "node scripts/wricket-hosted-preflight.mjs",
    "revamp:release:check": "node scripts/revamp-release-gate.mjs",
    "postinstall": "node scripts/patch-expo-sqlite-web.mjs",
    "production:reset": "node scripts/reset-production-data.mjs --production"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.109.0",
    "base64-js": "^1.5.1",
    "expo": "~54.0.36",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "html2canvas": "^1.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "15.8.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@types/react": "~19.1.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "sql.js": "^1.14.2",
    "supabase": "^2.109.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "private": true
}

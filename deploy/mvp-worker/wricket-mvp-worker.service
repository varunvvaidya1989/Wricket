[Unit]
Description=Wricket authoritative cricket MVP worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=wricket-mvp
Group=wricket-mvp
WorkingDirectory=/opt/wricket/mobile
Environment=NODE_ENV=production
EnvironmentFile=/etc/wricket/mvp-worker.env
ExecStart=/usr/bin/node scripts/cricket-mvp-worker.mjs --production
Restart=on-failure
RestartSec=15
TimeoutStopSec=180
StateDirectory=wricket-mvp
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
